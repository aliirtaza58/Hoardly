# Server Environment Variables
PORT=5000
CLIENT_URL=http://localhost:5173
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
STORAGE_SMOKE_ADMIN_EMAIL=admin@example.com
STORAGE_SMOKE_ADMIN_PASSWORD=your-admin-password
RESEND_API_KEY=your-resend-api-key
ORDER_CONFIRMATION_FROM=Hoardly <orders@example.com>

# Client Environment Variables
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional local-only admin simulator. Use a private client/.env.local file.
VITE_LOCAL_ADMIN_USERNAME=admin
VITE_LOCAL_ADMIN_PASSWORD=replace-with-a-local-password
